#:import dp kivy.metrics.dp

ScreenManager:
    LoginScreen:
    HomeScreen:
    DetailScreen:
    ProfileScreen:
    CartScreen:
    CheckoutScreen:

<BlueButton@Button>:
    background_color: 0, 0, 0, 0
    color: 0.05, 0.10, 0.16, 1
    font_size: "11sp"
    canvas.before:
        Color:
            rgba: 0.98, 0.98, 0.98, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]

<LoginScreen>:
    name: "login"

    canvas.before:
        Color:
            rgba: 0.025, 0.085, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size

    FloatLayout:

        Label:
            text: "Bluebean"
            font_size: "25sp"
            italic: True
            bold: False
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(180), dp(40)
            pos_hint: {"center_x": 0.5, "top": 0.91}

        Label:
            text: "C A F E"
            font_size: "6sp"
            color: 0.85, 0.87, 0.89, 1
            size_hint: None, None
            size: dp(80), dp(15)
            pos_hint: {"center_x": 0.5, "top": 0.855}

        Label:
            text: "Selamat Datang!"
            font_size: "15sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(220), dp(30)
            pos_hint: {"center_x": 0.5, "top": 0.785}

        Label:
            text: "Silahkan masuk untuk melanjutkan"
            font_size: "7sp"
            color: 0.72, 0.77, 0.82, 1
            size_hint: None, None
            size: dp(250), dp(20)
            pos_hint: {"center_x": 0.5, "top": 0.75}

        TextInput:
            id: email
            hint_text: "user@gmail.com"
            multiline: False
            font_size: "8sp"
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.70, 0.73, 0.76, 1
            background_color: 0, 0, 0, 0
            cursor_color: 1, 1, 1, 1
            padding: dp(32), dp(9)
            size_hint: None, None
            size: dp(156), dp(32)
            pos_hint: {"center_x": 0.5, "top": 0.665}

            canvas.before:
                Color:
                    rgba: 0.65, 0.70, 0.74, 1
                Line:
                    rounded_rectangle: self.x, self.y, self.width, self.height, dp(6)
                    width: 1

        Label:
            text: "✉"
            font_size: "9sp"
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {"center_x": 0.27, "top": 0.65}

        TextInput:
            id: password
            hint_text: "••••••••••"
            password: True
            multiline: False
            font_size: "8sp"
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.70, 0.73, 0.76, 1
            background_color: 0, 0, 0, 0
            cursor_color: 1, 1, 1, 1
            padding: dp(32), dp(9)
            size_hint: None, None
            size: dp(156), dp(32)
            pos_hint: {"center_x": 0.5, "top": 0.605}

            canvas.before:
                Color:
                    rgba: 0.65, 0.70, 0.74, 1
                Line:
                    rounded_rectangle: self.x, self.y, self.width, self.height, dp(6)
                    width: 1

        Label:
            text: "▣"
            font_size: "9sp"
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {"center_x": 0.27, "top": 0.59}

        Button:
            text: "◉"
            font_size: "8sp"
            background_color: 0, 0, 0, 0
            color: 0.75, 0.80, 0.85, 1
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {"center_x": 0.73, "top": 0.59}
            on_release:
                password.password = not password.password

        BlueButton:
            text: "Masuk"
            size_hint: None, None
            size: dp(156), dp(38)
            pos_hint: {"center_x": 0.5, "top": 0.515}
            on_release:
                root.manager.current = "home"

        Button:
            text: "Lupa kata sandi?"
            font_size: "7sp"
            background_color: 0, 0, 0, 0
            color: 0.75, 0.79, 0.83, 1
            size_hint: None, None
            size: dp(120), dp(20)
            pos_hint: {"center_x": 0.5, "top": 0.465}

        Label:
            text: "Belum punya akun? Daftar Sekarang"
            font_size: "7sp"
            color: 0.75, 0.79, 0.83, 1
            size_hint: None, None
            size: dp(220), dp(20)
            pos_hint: {"center_x": 0.5, "top": 0.405}

        Image:
            source: "coffee.jpg"
            allow_stretch: True
            keep_ratio: False
            size_hint: None, None
            size: dp(200), dp(160)
            pos_hint: {"center_x": 0.5, "y": 0}


<HomeScreen>:
    name: "home"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(10)

        Label:
            text: "Good Coffee, Good Vibes"
            font_size: "20sp"
            bold: True

        Label:
            text: "Menu Favorit: Bluebean Latte"

        Button:
            text: "Lihat Detail Produk"
            size_hint_y: None
            height: dp(45)
            on_release:
                root.manager.current = "detail"

        GridLayout:
            cols: 3
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)

            Button:
                text: "Home"

            Button:
                text: "Keranjang"
                on_release:
                    root.manager.current = "cart"

            Button:
                text: "Profile"
                on_release:
                    root.manager.current = "profile"


<DetailScreen>:
    name: "detail"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15)

        Label:
            text: "Detail Produk"
            font_size: "22sp"
            bold: True

        Label:
            text: "Bluebean Latte\\nRp. 28.000\\n\\nPerpaduan espresso dan susu segar"
            halign: "center"

        Button:
            text: "Tambah ke Keranjang"
            size_hint_y: None
            height: dp(50)
            on_release:
                root.manager.current = "cart"

        Button:
            text: "< Kembali ke Home"
            size_hint_y: None
            height: dp(40)
            on_release:
                root.manager.current = "home"


<ProfileScreen>:
    name: "profile"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15)

        Label:
            text: "Profil User"
            font_size: "22sp"
            bold: True

        Label:
            text: "User\\nuser@gmail.com"
            halign: "center"

        Button:
            text: "Keluar (Logout)"
            size_hint_y: None
            height: dp(45)
            on_release:
                root.manager.current = "login"

        Button:
            text: "Kembali ke Home"
            size_hint_y: None
            height: dp(45)
            on_release:
                root.manager.current = "home"


<CartScreen>:
    name: "cart"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15)

        Label:
            text: "Keranjang Belanja"
            font_size: "22sp"
            bold: True

        Label:
            text: "1x Bluebean Latte - Rp. 28.000\\n2x Matcha Latte - Rp. 54.000\\nTotal: Rp. 114.000"

        Button:
            text: "Bayar Sekarang"
            size_hint_y: None
            height: dp(50)
            on_release:
                root.manager.current = "checkout"

        Button:
            text: "< Kembali"
            size_hint_y: None
            height: dp(40)
            on_release:
                root.manager.current = "home"


<CheckoutScreen>:
    name: "checkout"

    BoxLayout:
        orientation: "vertical"
        padding: dp(20)
        spacing: dp(15)

        Label:
            text: "Pesanan Berhasil!"
            font_size: "24sp"
            bold: True

        Label:
            text: "No. Pesanan: #BBB243512\\nTotal: Rp. 114.000\\nEstimasi Pengiriman: 15-20 Menit"
            halign: "center"

        Button:
            text: "Kembali ke Home"
            size_hint_y: None
            height: dp(50)
            on_release:
                root.manager.current = "home" 